---
import SectionHeading from './SectionHeading.astro';
import LifecycleDiagram from './LifecycleDiagram.astro';
import { architectureCopy, lifecycleConstraints } from '../data/architecture';

const { lifecycle } = architectureCopy;
---

<section class="section lifecycle-section" id="lifecycle" aria-labelledby="lifecycle-title">
  <div class="container-site">
    <SectionHeading
      id="lifecycle-title"
      kicker={lifecycle.kicker}
      title={lifecycle.title}
      lead={lifecycle.lead}
    />

    <div class="reveal">
      <LifecycleDiagram />
    </div>

    <div class="lifecycle-lower reveal">
      <article class="micro-card" data-lifecycle-scenario aria-labelledby="micro-title">
        <p class="micro-code">示意 / 售后工单</p>
        <h3 id="micro-title" class="micro-title">
          {lifecycle.scenarioTitle}
        </h3>
        <ol class="state-list">
          <li>
            <span class="state-key">状态</span>
            <span>收到工单 → 查询订单与售后记录 → 起草回复 → 等待审批 → 输出并留痕。</span>
          </li>
          <li>
            <span class="state-key">权限</span>
            <span>客服 Agent 只读订单；退款写操作需要业务负责人权限；每次工具调用校验。</span>
          </li>
          <li>
            <span class="state-key">人工介入</span>
            <span>金额超阈值或高风险操作进入 HITL gate；审批人看到输入、工具调用与建议动作。</span>
          </li>
        </ol>
        <p class="micro-note">{lifecycle.scenarioNote}</p>
      </article>

      <div class="constraint-col">
        <h3 class="constraint-heading">三条约束，决定编排取舍。</h3>
        <div class="constraint-list">
          {lifecycleConstraints.map((constraint, index) => (
            <article class="constraint" data-lifecycle-constraint={constraint.id}>
              <span class="constraint-no">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h4 class="constraint-title">{constraint.title}</h4>
                <p class="constraint-body">{constraint.body}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .lifecycle-section {
    background: var(--color-paper);
  }

  .lifecycle-lower {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 24px;
    margin-top: 24px;
    align-items: start;
  }

  .micro-card {
    padding: 28px 28px 24px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-lg);
    background: var(--color-canvas);
  }

  .micro-code {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--color-red-dark);
    text-transform: uppercase;
  }

  .micro-title {
    margin-top: 10px;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .state-list {
    display: grid;
    gap: 0;
    margin-top: 20px;
    border-top: 1px solid var(--color-line);
  }

  .state-list li {
    display: grid;
    grid-template-columns: 74px minmax(0, 1fr);
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 13px;
    line-height: 1.75;
    color: var(--color-ink-2);
  }

  .state-key {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .micro-note {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .constraint-col {
    padding: 28px 28px 24px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-lg);
    background: var(--color-canvas);
  }

  .constraint-heading {
    font-size: 20px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }

  .constraint-list {
    display: grid;
    gap: 0;
    margin-top: 16px;
    border-top: 1px solid var(--color-line);
  }

  .constraint {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 10px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .constraint:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .constraint-no {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.6;
    color: var(--color-red-dark);
  }

  .constraint-title {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
  }

  .constraint-body {
    margin-top: 5px;
    font-size: 12px;
    line-height: 1.75;
    color: var(--color-muted);
  }

  @media (max-width: 1023px) {
    .lifecycle-lower {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .micro-card,
    .constraint-col {
      padding: 22px 20px 20px;
    }

    .state-list li {
      grid-template-columns: 1fr;
      gap: 3px;
    }

    .micro-title {
      font-size: 21px;
    }
  }
</style>
