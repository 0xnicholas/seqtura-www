---
import { contactHero } from '../data/contact';
---

<section class="contact-hero" aria-labelledby="contact-hero-title">
  <div class="container-site">
    <div class="hero-copy">
      <p class="kicker">{contactHero.kicker}</p>
      <h1 id="contact-hero-title" class="type-h1 hero-title">
        {contactHero.title}
      </h1>
      <p class="type-lead hero-lead">{contactHero.lead}</p>
      <p class="hero-note">
        <span class="hero-note-mark" aria-hidden="true"></span>
        {contactHero.note}
      </p>

      <div class="cta-row hero-actions">
        <a class="btn btn-primary" href="#channels" data-hero-cta>
          {contactHero.primaryCta}
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M8 3v9M4 8.5 8 12.5 12 8.5"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
        </a>
        <a class="btn btn-ghost" href="/methodology">
          {contactHero.secondaryCta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-hero {
    position: relative;
    overflow: hidden;
    padding: 96px 0 88px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .contact-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: max(var(--gutter), calc((100vw - var(--container-site)) / 2));
    width: 7px;
    height: 7px;
    background: var(--color-red);
  }

  .contact-hero::after {
    content: '';
    position: absolute;
    top: 12%;
    left: 56%;
    width: 54%;
    height: 70%;
    background: radial-gradient(closest-side, rgb(255 45 32 / 8%), rgb(255 45 32 / 0%) 74%);
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 920px;
    animation: hero-in 600ms var(--ease-site) both;
  }

  .hero-title {
    margin-top: 24px;
  }

  .hero-lead {
    max-width: 720px;
    margin-top: 26px;
    color: var(--color-muted);
  }

  .hero-note {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: 10px;
    max-width: 680px;
    margin-top: 22px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-ink-2);
  }

  .hero-note-mark {
    width: 7px;
    height: 7px;
    margin-top: 8px;
    background: var(--color-red);
  }

  .hero-actions {
    margin-top: 34px;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 767px) {
    .contact-hero {
      padding: 64px 0 56px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy {
      animation: none;
    }
  }
</style>
