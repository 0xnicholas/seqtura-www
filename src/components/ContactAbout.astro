---
import ArrowUpRightIcon from './ArrowUpRightIcon.astro';
import { legal } from '../config/legal';
import { contactAbout, contactFacts } from '../data/contact';

const facts = contactFacts(legal.operatorName, legal.operatorLocation);
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container-site about-grid">
    <div class="about-intro">
      <p class="kicker">{contactAbout.kicker}</p>
      <h2 id="about-title" class="type-h2 about-title">{contactAbout.title}</h2>
      <div class="about-links">
        <a class="text-link" href="/methodology">
          {contactAbout.methodologyLink}
          <ArrowUpRightIcon />
        </a>
        <a class="text-link" href="/architecture">
          {contactAbout.architectureLink}
          <ArrowUpRightIcon />
        </a>
      </div>
    </div>

    <div class="about-body">
      <p class="type-lead about-lead">{contactAbout.paragraphs[0]}</p>
      <p class="about-text">{contactAbout.paragraphs[1]}</p>
      <p class="about-principle">{contactAbout.paragraphs[2]}</p>

      <dl class="about-facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 72px;
    align-items: start;
  }

  .about-intro {
    position: sticky;
    top: calc(var(--header-h) + 40px);
  }

  .about-title {
    margin-top: 18px;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 28px;
  }

  .about-body {
    max-width: 680px;
    min-width: 0;
  }

  .about-lead {
    color: var(--color-ink-2);
  }

  .about-text {
    margin-top: 20px;
    color: var(--color-ink-2);
  }

  .about-principle {
    margin-top: 26px;
    padding-left: 18px;
    border-left: 2px solid var(--color-red);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-ink);
  }

  .about-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 40px;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .about-facts div {
    min-width: 0;
    padding: 16px 18px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .about-facts dt {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  .about-facts dd {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-ink);
    overflow-wrap: anywhere;
  }

  @media (max-width: 1023px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .about-intro {
      position: static;
    }
  }

  @media (max-width: 767px) {
    .about-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
