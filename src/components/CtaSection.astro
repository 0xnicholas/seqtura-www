---
import ArrowIcon from './ArrowIcon.astro';
import { placeholders } from '../config/placeholders';
import { site } from '../config/site';
import { homeSections } from '../data/homepage';

const { cta } = homeSections;
---

<section class="section cta-section" id="next-step" aria-labelledby="cta-title">
  <div class="container-site">
    <div class="cta-inner reveal">
      <p class="kicker">{cta.kicker}</p>
      <h2 id="cta-title" class="type-h2 cta-title">
        {cta.title}
      </h2>
      <p class="type-lead cta-lead">{cta.lead}</p>
      <div class="cta-row cta-actions">
        <a class="btn btn-primary" href={site.contactPath} data-primary-cta>
          {cta.primaryCta}
          <ArrowIcon />
        </a>
        <a class="btn btn-ghost" href={`mailto:${placeholders.contactEmail.value}`}>
          {cta.secondaryCta}
        </a>
      </div>
      <p class="cta-note">{cta.note}</p>
    </div>
  </div>
</section>

<style>
  .cta-section {
    overflow: hidden;
    padding-block: 128px 136px;
    background:
      radial-gradient(54% 70% at 50% 78%, rgb(255 45 32 / 14%), transparent 72%),
      var(--color-canvas);
    text-align: center;
  }

  .cta-inner {
    max-width: 820px;
    margin-inline: auto;
  }

  .cta-title {
    margin-top: 18px;
  }

  .cta-lead {
    max-width: 640px;
    margin: 22px auto 0;
    color: var(--color-muted);
  }

  .cta-actions {
    justify-content: center;
    margin-top: 34px;
  }

  .cta-note {
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .cta-section {
      padding-block: 88px 96px;
    }

    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-actions .btn {
      width: 100%;
    }

    .cta-note {
      margin-top: 18px;
      font-size: 10px;
    }
  }
</style>
