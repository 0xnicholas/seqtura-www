---
import ContactForm from './ContactForm.astro';
import { bookingCopy } from '../data/contact';
---

<section class="section booking" id="book" aria-labelledby="book-title">
  <div class="container-site booking-grid">
    <div class="booking-intro">
      <p class="kicker">{bookingCopy.kicker}</p>
      <h2 id="book-title" class="type-h2 booking-title">{bookingCopy.title}</h2>
      <p class="type-lead booking-lead">{bookingCopy.lead}</p>

      <ol class="booking-steps" aria-label="提交后会发生什么">
        {bookingCopy.steps.map((step) => (
          <li>
            <span class="step-no" aria-hidden="true">{step.no}</span>
            <div>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-text">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="booking-note">{bookingCopy.note}</p>
    </div>

    <ContactForm />
  </div>
</section>

<style>
  .booking-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 72px;
    align-items: start;
  }

  .booking-intro {
    position: sticky;
    top: calc(var(--header-h) + 40px);
    min-width: 0;
  }

  .booking-title {
    margin-top: 18px;
  }

  .booking-lead {
    max-width: 480px;
    margin-top: 22px;
    color: var(--color-muted);
  }

  .booking-steps {
    display: grid;
    margin-top: 36px;
    border-top: 1px solid var(--color-line);
  }

  .booking-steps li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .step-no {
    padding-top: 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--color-red-dark);
  }

  .step-title {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
  }

  .step-text {
    margin-top: 5px;
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .booking-note {
    margin-top: 22px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  @media (max-width: 1023px) {
    .booking-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .booking-intro {
      position: static;
    }

    .booking-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-left: 1px solid var(--color-line);
    }

    .booking-steps li {
      display: block;
      padding: 16px;
      border-right: 1px solid var(--color-line);
    }

    .booking-steps li:last-child {
      border-right: 0;
    }

    .step-title {
      margin-top: 8px;
    }
  }

  @media (max-width: 767px) {
    .booking-steps {
      grid-template-columns: 1fr;
      border-left: 0;
    }

    .booking-steps li {
      display: grid;
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 14px;
      padding: 16px 0;
      border-right: 0;
    }

    .step-title {
      margin-top: 0;
    }
  }
</style>
