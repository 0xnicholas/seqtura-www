---
import { deploymentNote, deploymentTiers } from '../data/architecture';
---

<section class="deployment" aria-labelledby="deployment-title">
  <div class="deployment-head">
    <div>
      <p class="mono-label deployment-label">部署形态 / 参考对比</p>
      <h3 id="deployment-title" class="deployment-title">
        三档部署，三种责任边界。
      </h3>
    </div>
    <p class="deployment-note">{deploymentNote}</p>
  </div>

  <div class="tier-grid" data-deployment-grid>
    {deploymentTiers.map((tier) => (
      <article
        class="tier"
        data-deployment-tier={tier.id}
        aria-labelledby={`tier-${tier.id}-title`}
      >
        <span class="tier-no">{tier.no}</span>
        <h4 id={`tier-${tier.id}-title`} class="tier-name">
          {tier.name}
        </h4>
        <p class="tier-label">{tier.label}</p>
        <dl class="tier-facts">
          <div>
            <dt>谁运维</dt>
            <dd>{tier.operator}</dd>
          </div>
          <div>
            <dt>数据在哪</dt>
            <dd>{tier.data}</dd>
          </div>
          <div>
            <dt>模型能否离线</dt>
            <dd>{tier.offline}</dd>
          </div>
          <div>
            <dt>选择依据</dt>
            <dd>{tier.when}</dd>
          </div>
        </dl>
      </article>
    ))}
  </div>
</section>

<style>
  .deployment {
    margin-top: 24px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-lg);
    background: var(--color-paper);
  }

  .deployment-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: 24px;
    align-items: end;
    padding: 24px 26px;
    border-bottom: 1px solid var(--color-line);
  }

  .deployment-label {
    color: var(--color-red-dark);
  }

  .deployment-title {
    margin-top: 10px;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .deployment-note {
    font-size: 12px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .tier-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .tier {
    min-width: 0;
    padding: 24px 24px 26px;
    border-right: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .tier:last-child {
    border-right: 0;
  }

  .tier-no {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--color-red-dark);
  }

  .tier-name {
    margin-top: 8px;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.3;
  }

  .tier-label {
    margin-top: 2px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .tier-facts {
    display: grid;
    gap: 0;
    margin-top: 18px;
    border-top: 1px solid var(--color-line);
  }

  .tier-facts > div {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .tier-facts dt {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .tier-facts dd {
    margin-top: 4px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-ink-2);
  }

  @media (max-width: 1023px) {
    .deployment-head {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 767px) {
    .deployment {
      margin-top: 18px;
    }

    .deployment-head {
      padding: 20px;
    }

    .tier-grid {
      grid-template-columns: 1fr;
    }

    .tier {
      padding: 20px;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .tier:last-child {
      border-bottom: 0;
    }
  }
</style>
