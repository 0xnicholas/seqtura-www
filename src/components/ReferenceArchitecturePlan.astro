---
import { capabilityLayers, controlPlanes, structuralNote } from '../data/architecture';
---

<div class="arch-panel">
  <div class="arch-top">
    <span>REFERENCE ARCHITECTURE / 交付参考架构</span>
    <span class="status">
      <i aria-hidden="true"></i>5 LAYERS + 3 PLANES
    </span>
  </div>

  <div
    class="arch-canvas"
    role="img"
    aria-label="交付参考架构：5 层能力栈横切 3 条控制面；Seqtura 交付组件与模式，客户保留系统、数据、身份与审批权。"
  >
    <div class="plane-labels" aria-hidden="true">
      {controlPlanes.map((plane) => (
        <span class="plane-label">
          {plane.short} {plane.name}
        </span>
      ))}
    </div>
    <div class="plane-line p1" aria-hidden="true"></div>
    <div class="plane-line p2" aria-hidden="true"></div>
    <div class="plane-line p3" aria-hidden="true"></div>

    <div class="arch-rows">
      {capabilityLayers.map((layer) => (
        <div class="arch-row">
          <span class="arch-no">{layer.no}</span>
          <div class="arch-name">
            <b>{layer.name}</b>
            <span>{layer.label}</span>
          </div>
          <p class="arch-desc">{layer.summary}</p>
          <div class="arch-chips">
            {layer.chips.map((chip) => (
              <span class="chip">{chip}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="arch-boundary">
      <span>SEQTURA 交付边界：组件与模式</span>
      <span>客户环境：系统 · 数据 · 身份 · 审批</span>
    </p>
    <p class="arch-structural" data-structural-note>
      {structuralNote}
    </p>
  </div>
</div>

<style>
  .arch-panel {
    display: flex;
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-lg);
    background: var(--color-canvas);
    box-shadow: var(--shadow-site-xs);
    transition: border-color 150ms var(--ease-site);
  }

  .arch-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    padding: 13px 20px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-muted);
  }

  .status i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-red);
  }

  .arch-canvas {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 52px 20px 20px;
  }

  .plane-labels {
    position: absolute;
    top: 10px;
    right: 20px;
    left: 20px;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .plane-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: var(--color-red-dark);
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .plane-label::before {
    content: '';
    flex: none;
    width: 4px;
    height: 4px;
    background: var(--color-red);
  }

  .plane-line {
    position: absolute;
    top: 36px;
    bottom: 48px;
    z-index: 2;
    width: 1px;
    border-left: 1px dashed rgb(255 45 32 / 38%);
    pointer-events: none;
  }

  .plane-line.p1 {
    left: 22%;
  }

  .plane-line.p2 {
    left: 50%;
  }

  .plane-line.p3 {
    left: 78%;
  }

  .arch-rows {
    position: relative;
    z-index: 3;
    flex: 1;
  }

  .arch-row {
    display: grid;
    grid-template-columns: 34px 132px minmax(0, 1fr) auto;
    gap: 12px;
    align-items: center;
    min-height: 70px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--color-line);
    background: rgb(255 255 255 / 80%);
  }

  .arch-row:last-child {
    border-bottom: 0;
  }

  .arch-no {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  .arch-name b {
    display: block;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.4;
  }

  .arch-name span {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    line-height: 1.5;
    color: var(--color-muted);
  }

  .arch-desc {
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .arch-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    justify-content: flex-end;
  }

  .arch-boundary {
    position: relative;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
    margin-top: 16px;
    padding-top: 10px;
    border-top: 1px dashed var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: 0.03em;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .arch-structural {
    position: relative;
    z-index: 3;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.6;
    letter-spacing: 0.03em;
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 767px) {
    .arch-canvas {
      padding: 64px 14px 16px;
    }

    .plane-labels {
      right: 14px;
      left: 14px;
    }

    .plane-label {
      font-size: 8px;
      white-space: normal;
    }

    .plane-line {
      top: 50px;
    }

    .arch-row {
      grid-template-columns: 26px minmax(0, 1fr);
      gap: 2px 8px;
      min-height: 0;
      padding: 12px 10px;
    }

    .arch-desc {
      grid-column: 2;
      font-size: 11px;
    }

    .arch-chips {
      display: none;
    }

    .arch-boundary {
      flex-direction: column;
    }
  }
</style>
