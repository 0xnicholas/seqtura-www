---
interface Props {
  id: string;
  kicker: string;
  title: string;
  lead?: string;
}

const { id, kicker, title, lead } = Astro.props;
---

<header class="section-heading reveal">
  <p class="kicker">{kicker}</p>
  <h2 id={id} class="type-h2 section-title">
    {title}
  </h2>
  {lead && <p class="type-lead section-lead">{lead}</p>}
</header>

<style>
  .section-heading {
    max-width: 960px;
    margin: 0 auto 68px;
    text-align: center;
  }

  .section-title {
    margin-top: 18px;
  }

  .section-lead {
    max-width: 720px;
    margin: 22px auto 0;
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .section-heading {
      margin-bottom: 44px;
    }

    .section-lead {
      margin-top: 18px;
    }
  }
</style>
