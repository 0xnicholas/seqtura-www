---
import SectionHeading from './SectionHeading.astro';
import { architectureCopy, enterpriseConcerns } from '../data/architecture';

const { concerns } = architectureCopy;
---

<section class="section concerns-section" id="concerns" aria-labelledby="concerns-title">
  <div class="container-site">
    <SectionHeading
      id="concerns-title"
      kicker={concerns.kicker}
      title={concerns.title}
      lead={concerns.lead}
    />

    <div class="concern-grid reveal">
      {enterpriseConcerns.map((concern) => (
        <article class="concern" data-concern={concern.id}>
          <div class="concern-head">
            <span class="concern-no">{concern.no}</span>
            <h3 class="concern-title">{concern.title}</h3>
          </div>
          <dl class="concern-facts">
            <div class="concern-row" data-concern-field="question">
              <dt>问题</dt>
              <dd>{concern.question}</dd>
            </div>
            <div class="concern-row" data-concern-field="mechanism">
              <dt>机制</dt>
              <dd>{concern.mechanism}</dd>
            </div>
            <div class="concern-row" data-concern-field="boundary">
              <dt>边界</dt>
              <dd>{concern.boundary}</dd>
            </div>
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .concerns-section {
    background: var(--color-canvas);
  }

  .concern-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .concern {
    position: relative;
    min-width: 0;
    padding: 30px 30px 26px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .concern:first-child::before {
    content: '';
    position: absolute;
    top: -4px;
    left: -4px;
    width: 7px;
    height: 7px;
    background: var(--color-red);
  }

  .concern:last-child {
    grid-column: span 2;
  }

  .concern-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--color-line);
  }

  .concern-no {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-red-dark);
  }

  .concern-title {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .concern-facts {
    display: grid;
    gap: 0;
  }

  .concern-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .concern-row:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .concern-row dt {
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.8;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .concern-row dd {
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-ink-2);
  }

  .concern-row[data-concern-field='boundary'] dd {
    color: var(--color-muted);
  }

  @media (max-width: 767px) {
    .concern-grid {
      grid-template-columns: 1fr;
    }

    .concern {
      padding: 24px 20px 22px;
    }

    .concern:last-child {
      grid-column: auto;
    }

    .concern-title {
      font-size: 20px;
    }

    .concern-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
