---
import ArrowUpRightIcon from './ArrowUpRightIcon.astro';
import { contactChannels } from '../data/contact';
import { placeholders, showPlaceholderMarks } from '../config/placeholders';

const email = placeholders.contactEmail.value;
const wecomQr = placeholders.wecomQr.value;
const feishuUrl = placeholders.feishuUrl.value;

const availability = {
  wecom: { configured: Boolean(wecomQr), placeholder: placeholders.wecomQr.isPlaceholder },
  feishu: { configured: Boolean(feishuUrl), placeholder: placeholders.feishuUrl.isPlaceholder },
  email: { configured: true, placeholder: placeholders.contactEmail.isPlaceholder },
} as const;
---

<section class="section channels" id="channels" aria-labelledby="channels-title">
  <div class="container-site">
    <header class="channels-head">
      <p class="kicker">{contactChannels.kicker}</p>
      <h2 id="channels-title" class="type-h2 channels-title">
        {contactChannels.title}
      </h2>
      <p class="type-lead channels-lead">{contactChannels.lead}</p>
    </header>

    <ul class="channel-grid">
      {contactChannels.channels.map((channel) => {
        const state = availability[channel.id];
        return (
          <li class="channel-card" data-channel={channel.id}>
            <div class="channel-meta">
              <span class="channel-no">{channel.no}</span>
              {showPlaceholderMarks && state.placeholder && (
                <span class="channel-badge" data-placeholder-badge>
                  占位
                </span>
              )}
            </div>
            <h3 class="type-h3 channel-title">{channel.title}</h3>

            {channel.id === 'wecom' &&
              (wecomQr ? (
                <>
                  <img
                    class="channel-qr"
                    src={wecomQr}
                    alt="企业微信二维码"
                    width="168"
                    height="168"
                    loading="lazy"
                  />
                  <p class="channel-note">{channel.configuredNote}</p>
                </>
              ) : (
                <p class="channel-note">
                  {channel.fallbackNote}
                  <a href={`mailto:${email}`}>{email}</a>。
                </p>
              ))}

            {channel.id === 'feishu' &&
              (feishuUrl ? (
                <>
                  <a class="channel-link" href={feishuUrl} target="_blank" rel="noopener">
                    打开飞书
                    <ArrowUpRightIcon />
                  </a>
                  <p class="channel-note">{channel.configuredNote}</p>
                </>
              ) : (
                <p class="channel-note">
                  {channel.fallbackNote}
                  <a href={`mailto:${email}`}>{email}</a>。
                </p>
              ))}

            {channel.id === 'email' && (
              <>
                <a class="channel-email" href={`mailto:${email}`}>
                  {email}
                </a>
                <p class="channel-note">{channel.configuredNote}</p>
              </>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .channels-head {
    max-width: 720px;
  }

  .channels-title {
    margin-top: 18px;
  }

  .channels-lead {
    margin-top: 20px;
    color: var(--color-muted);
  }

  .channel-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 48px;
  }

  .channel-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 26px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-lg);
    background: var(--color-paper);
  }

  .channel-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .channel-no {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--color-red-dark);
  }

  .channel-badge {
    padding: 2px 6px;
    border: 1px dashed var(--color-line-strong);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .channel-title {
    margin-top: 18px;
    font-size: 24px;
    line-height: 1.3;
  }

  .channel-qr {
    width: 168px;
    max-width: 100%;
    height: auto;
    margin-top: 22px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-sm);
    background: var(--color-canvas);
  }

  .channel-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
    margin-top: 22px;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--color-line-strong);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-red-dark);
    transition: border-color var(--duration-micro) var(--ease-site);
  }

  .channel-link:hover {
    border-bottom-color: currentColor;
  }

  .channel-email {
    align-self: flex-start;
    max-width: 100%;
    margin-top: 22px;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--color-line-strong);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-ink);
    overflow-wrap: anywhere;
    transition:
      color var(--duration-micro) var(--ease-site),
      border-color var(--duration-micro) var(--ease-site);
  }

  .channel-email:hover {
    border-bottom-color: var(--color-red);
    color: var(--color-red-dark);
  }

  .channel-note {
    margin-top: 16px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .channel-note a {
    color: var(--color-red-dark);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .channel-grid {
      grid-template-columns: 1fr;
      margin-top: 34px;
    }

    .channel-card {
      padding: 22px;
    }
  }
</style>
