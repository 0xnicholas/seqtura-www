<style>
  .stack-art {
    position: relative;
    width: 108%;
    max-width: none;
    height: auto;
    margin-left: -4%;
    overflow: visible;
  }

  /* Ambient stroke drift: the only site-wide ambient motion. The dashoffset
     shift equals the dash period (3+6 / 3+4) so the 24s loop is seamless. */
  .stack-flow {
    animation: stack-flow-dash var(--duration-ambient) linear infinite;
  }

  .stack-flow-path {
    animation: stack-flow-dash-path var(--duration-ambient) linear infinite;
  }

  @keyframes stack-flow-dash {
    to {
      stroke-dashoffset: -9;
    }
  }

  @keyframes stack-flow-dash-path {
    to {
      stroke-dashoffset: -7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-flow,
    .stack-flow-path {
      animation: none;
    }
  }
</style>
