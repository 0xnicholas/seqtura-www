---
// PROTOTYPE graphic-language (#29), variant A card strip: the group's two
// stages as a filled isometric step pair; the gate stage (Define/Validate/
// Deploy) gets the red slab. Throwaway — drop with the prototype.
interface Props {
  stages: readonly { no: string; nameCn: string }[];
  gate?: number;
}
const { stages, gate = -1 } = Astro.props;
const slabs = stages.map((stage, i) => ({
  cx: 110 + i * 220,
  stage,
  red: i === gate,
}));
---

<svg viewBox="0 0 480 108" role="img" aria-label="阶段等距示意图">
  {
    slabs.map(({ cx, stage, red }, i) => (
      <g aria-hidden="true">
        {i === 0 && slabs.length > 1 && (
          <g stroke="#F53003" stroke-opacity=".55" fill="none">
            <line x1={cx + 66} y1="58" x2={cx + 150} y2="58" />
            <polyline points={`${cx + 142},51 ${cx + 152},58 ${cx + 142},65`} />
          </g>
        )}
        <g stroke="#171717" stroke-opacity=".18">
          <polygon
            points={`${cx},34 ${cx + 58},58 ${cx},82 ${cx - 58},58`}
            fill={red ? '#F53003' : '#171717'}
            fill-opacity={red ? '.9' : '.08'}
          />
          <polygon
            points={`${cx - 58},58 ${cx},82 ${cx},92 ${cx - 58},68`}
            fill={red ? '#F53003' : '#171717'}
            fill-opacity={red ? '.55' : '.05'}
          />
          <polygon
            points={`${cx},82 ${cx + 58},58 ${cx + 58},68 ${cx},92`}
            fill={red ? '#F53003' : '#171717'}
            fill-opacity={red ? '.7' : '.065'}
          />
        </g>
        <text
          x={cx}
          y="63"
          text-anchor="middle"
          font-family="'SF Mono', 'JetBrains Mono', ui-monospace, Menlo, monospace"
          font-size="10"
          fill={red ? '#FFFFFF' : '#C42602'}
        >
          {stage.no}
        </text>
        <text
          x={cx}
          y="104"
          text-anchor="middle"
          font-family="-apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif"
          font-size="11"
          fill="#404040"
        >
          {stage.nameCn}
        </text>
      </g>
    ))
  }
</svg>
