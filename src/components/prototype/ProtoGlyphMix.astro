---
// PROTOTYPE graphic-language (#29), variant C mini glyph: wireframe isometric
// stack with a red tick annotation.
interface Props {
  index?: number;
  class?: string;
}
const { index = 0, class: className } = Astro.props;
const accent = index % 3;
const slabs = [0, 1, 2].map((i) => ({ ty: 8 + i * 12, red: i === accent }));
---

<svg
  class={className}
  viewBox="0 0 72 56"
  role="img"
  aria-label="混合线框小图"
>
  {
    slabs.map(({ ty, red }) => (
      <g
        fill={red ? '#F53003' : 'none'}
        fill-opacity={red ? '.85' : undefined}
        stroke={red ? '#F53003' : '#171717'}
        stroke-opacity={red ? '1' : '.45'}
        aria-hidden="true"
      >
        <polygon points={`36,${ty} 62,${ty + 10} 36,${ty + 20} 10,${ty + 10}`} />
        <path
          d={`M10,${ty + 10} L36,${ty + 20} L36,${ty + 24} L10,${ty + 14} Z M36,${ty + 20} L62,${ty + 10} L62,${ty + 14} L36,${ty + 24}`}
          fill="none"
        />
      </g>
    ))
  }
  <rect x="64" y="6" width="5" height="5" fill="#F53003" aria-hidden="true"></rect>
</svg>
