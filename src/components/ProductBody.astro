---
import ArrowIcon from './ArrowIcon.astro';
import SectionHeading from './SectionHeading.astro';
import { productList, type ProductCopy } from '../data/products';

interface Props {
  product: ProductCopy;
}

const { product } = Astro.props;
---

<section class="section" id="what" aria-labelledby="what-title">
  <div class="container-site">
    <SectionHeading
      id="what-title"
      kicker={product.what.kicker}
      title={product.what.title}
      lead={product.what.lead}
    />

    <dl class="product-facts reveal">
      {product.what.facts.map((fact) => (
        <div class="product-fact">
          <dt>{fact.label}</dt>
          <dd>{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="section product-place" id="place" aria-labelledby="place-title">
  <div class="container-site">
    <SectionHeading
      id="place-title"
      kicker={product.place.kicker}
      title={product.place.title}
      lead={product.place.lead}
    />

    <p class="place-link reveal">
      <a class="text-link" href="/architecture">
        {product.place.linkLabel}
        <ArrowIcon />
      </a>
    </p>

    <nav class="product-line reveal" aria-label="产品线">
      <p class="mono-label line-label">同一条产品线</p>
      <ul>
        {productList.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={item.id === product.id ? 'page' : undefined}
              data-product-link={item.id}
            >
              <span class="line-no">{item.no}</span>
              <span class="line-name">{item.name}</span>
              <span class="line-category">{item.category}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>

<style>
  .product-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .product-fact {
    min-width: 0;
    padding: 24px 22px 26px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .product-fact dt {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--color-red-dark);
  }

  .product-fact dd {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-ink-2);
  }

  .product-place {
    border-bottom: 0;
  }

  .place-link {
    margin-top: 4px;
    text-align: center;
  }

  .product-line {
    max-width: 960px;
    margin: 64px auto 0;
  }

  .line-label {
    margin-bottom: 12px;
    color: var(--color-muted);
  }

  .product-line ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .product-line a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    height: 100%;
    padding: 18px 20px 20px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
    transition:
      background-color var(--duration-micro) var(--ease-site),
      color var(--duration-micro) var(--ease-site);
  }

  .product-line a:hover {
    background: var(--color-red-tint);
  }

  /* 当前页子项常驻 14% 底，与导航 #60 判例同款表达。
     填充底上的文字随底色深一档，否则红 #cd2318、灰 #737373 在 #ffe2dd 上分别只有
     4.46:1 与 3.87:1，过不了 axe 的 4.5:1。 */
  .product-line a[aria-current='page'] {
    background: var(--color-red-faded);
  }

  .product-line a[aria-current='page'] .line-no,
  .product-line a[aria-current='page'] .line-category {
    color: var(--color-ink-2);
  }

  .line-no {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-red-dark);
  }

  .line-name {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink);
  }

  .line-category {
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  @media (max-width: 1023px) {
    .product-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .product-facts,
    .product-line ul {
      grid-template-columns: 1fr;
    }

    .product-fact {
      padding: 20px 18px 22px;
    }

    .product-line {
      margin-top: 48px;
    }
  }
</style>
