---
import ArrowIcon from './ArrowIcon.astro';
import { processHero } from '../data/process';
import { site } from '../config/site';
---

<section class="process-hero" aria-labelledby="process-hero-title">
  <div class="container-site">
    <p class="kicker">{processHero.kicker}</p>
    <h1 id="process-hero-title" class="type-h1 hero-title">
      <span class="hero-title-nowrap">{processHero.titleLead}</span>
      {processHero.titleTail}
    </h1>
    <p class="type-lead hero-lead">{processHero.lead}</p>

    <div class="cta-row hero-actions">
      <a class="btn btn-primary" href={site.bookingPath} data-primary-cta>
        {processHero.primaryCta}
        <ArrowIcon />
      </a>
      <a class="btn btn-ghost" href="/architecture">
        {processHero.secondaryCta}
      </a>
    </div>
  </div>
</section>

<style>
  .process-hero {
    position: relative;
    overflow: hidden;
    padding: 96px 0 88px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .process-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: max(var(--gutter), calc((100vw - var(--container-site)) / 2));
    width: 7px;
    height: 7px;
    background: var(--color-red);
  }

  .process-hero::after {
    content: '';
    position: absolute;
    top: 8%;
    left: 56%;
    width: 54%;
    height: 76%;
    background: radial-gradient(closest-side, rgb(245 48 3 / 9%), rgb(245 48 3 / 0%) 74%);
    pointer-events: none;
  }

  .hero-title,
  .hero-lead,
  .hero-actions,
  .process-hero .kicker {
    position: relative;
    z-index: 1;
  }

  .hero-title {
    max-width: 920px;
    margin-top: 24px;
  }

  .hero-title-nowrap {
    white-space: nowrap;
  }

  .hero-lead {
    max-width: 680px;
    margin-top: 26px;
    color: var(--color-muted);
  }

  .hero-actions {
    margin-top: 34px;
  }

  @media (max-width: 767px) {
    .process-hero {
      padding: 64px 0 56px;
    }

    .hero-lead {
      margin-top: 20px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      margin-top: 28px;
    }

    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
