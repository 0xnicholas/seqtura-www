---
import ArrowIcon from './ArrowIcon.astro';
import { methodologyCopy } from '../data/delivery';
import { site } from '../config/site';

const { hero } = methodologyCopy;
---

<section class="method-hero" aria-labelledby="method-hero-title">
  <div class="container-site">
    <div class="hero-copy">
      <p class="kicker">{hero.kicker}</p>
      <h1 id="method-hero-title" class="type-h1 hero-title">
        {hero.title}
      </h1>
      <p class="type-lead hero-lead">{hero.lead}</p>

      <div class="cta-row hero-actions">
        <a class="btn btn-primary" href={site.contactPath} data-primary-cta>
          {hero.primaryCta}
          <ArrowIcon />
        </a>
        <a class="btn btn-ghost" href="/process">
          {hero.secondaryCta}
        </a>
      </div>

      <ul class="hero-facts" aria-label="方法论概览">
        {hero.facts.map((fact) => (
          <li>{fact}</li>
        ))}
      </ul>

      <p class="fde-note">
        <span class="fde-mark" aria-hidden="true"></span>
        {hero.fdeNote}
      </p>
    </div>
  </div>
</section>

<style>
  .method-hero {
    position: relative;
    overflow: hidden;
    padding: 96px 0 88px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .method-hero::after {
    content: '';
    position: absolute;
    top: 12%;
    left: 58%;
    width: 52%;
    height: 70%;
    background: radial-gradient(closest-side, rgb(255 45 32 / 8%), rgb(255 45 32 / 0%) 74%);
    pointer-events: none;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 900px;
    animation: hero-in var(--duration-enter) var(--ease-site) both;
  }

  .hero-title {
    margin-top: 24px;
  }

  .hero-lead {
    max-width: 720px;
    margin-top: 26px;
    color: var(--color-muted);
  }

  .hero-actions {
    margin-top: 34px;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    max-width: 720px;
    margin-top: 44px;
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .hero-facts li {
    flex: 1 1 0;
    min-width: 0;
    padding: 14px 18px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-ink-2);
    text-transform: uppercase;
    white-space: nowrap;
  }

  .fde-note {
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: 10px;
    max-width: 720px;
    margin-top: 24px;
    font-size: 13px;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .fde-mark {
    align-self: start;
    width: 7px;
    height: 7px;
    margin-top: 8px;
    background: var(--color-red);
  }

  @media (max-width: 767px) {
    .method-hero {
      padding: 64px 0 56px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-facts {
      margin-top: 32px;
    }

    .hero-facts li {
      flex: 1 1 100%;
      padding: 11px 14px;
      white-space: normal;
    }

    .fde-note {
      margin-top: 18px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy {
      animation: none;
    }
  }
</style>
