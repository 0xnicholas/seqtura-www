---
import ArrowIcon from './ArrowIcon.astro';
import IsometricCapabilityStack from './IsometricCapabilityStack.astro';
import { site } from '../config/site';
import { homeHero } from '../data/homepage';
import { structuralNote } from '../data/architecture';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container-site hero-grid">
    <div class="hero-copy">
      <p class="kicker">{homeHero.kicker}</p>
      <h1 id="hero-title" class="type-h1 hero-title">
        <span class="title-line">{homeHero.titleLead}</span>
        <span class="title-line">{homeHero.titleTail}</span>
      </h1>
      <p class="hero-lead type-lead">{homeHero.lead}</p>
      <div class="cta-row hero-actions">
        <a class="btn btn-primary" href={site.contactPath} data-primary-cta>
          {homeHero.primaryCta}
          <ArrowIcon />
        </a>
        <a class="btn btn-ghost" href="/methodology">
          {homeHero.secondaryCta}
        </a>
      </div>
      <p class="hero-facts">
        {homeHero.facts.map((fact, index) => (
          <>
            {index > 0 && <span class="sep" aria-hidden="true"></span>}
            <span data-hero-fact>{fact}</span>
          </>
        ))}
      </p>
    </div>

    <div class="hero-art" data-hero-art>
      <IsometricCapabilityStack />
      <p class="art-caption">
        <span>{homeHero.caption}</span>
        <span class="art-note" data-structural-note>
          {structuralNote}
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 48px;
    align-items: center;
    min-height: 656px;
  }

  .hero-copy {
    max-width: 620px;
    padding: 88px 0 96px;
  }

  .hero-title {
    margin-top: 22px;
  }

  .title-line {
    display: inline-block;
  }

  .hero-lead {
    max-width: 520px;
    margin-top: 26px;
    color: var(--color-muted);
  }

  .hero-actions {
    margin-top: 34px;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    max-width: 520px;
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .hero-facts .sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-line-strong);
  }

  .hero-art {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    margin-right: -24px;
    padding: 24px 0 56px;
  }

  .hero-art::before {
    content: '';
    position: absolute;
    top: 8%;
    right: -2%;
    width: 92%;
    height: 86%;
    background: radial-gradient(closest-side, rgb(255 45 32 / 12%), rgb(255 45 32 / 0%) 72%);
    pointer-events: none;
  }

  .art-caption {
    position: relative;
    display: grid;
    gap: 2px;
    margin-top: 4px;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .art-note {
    font-size: 9px;
    color: var(--color-muted);
  }

  .hero-copy > * {
    animation: blur-up var(--duration-hero) var(--ease-site) both;
  }

  .hero-copy > *:nth-child(1) {
    animation-delay: 0ms;
  }

  .hero-copy > *:nth-child(2) {
    animation-delay: 200ms;
  }

  .hero-copy > *:nth-child(3) {
    animation-delay: 400ms;
  }

  .hero-copy > *:nth-child(4) {
    animation-delay: 600ms;
  }

  .hero-copy > *:nth-child(5) {
    animation-delay: 800ms;
  }

  .hero-art {
    animation: blur-up var(--duration-hero) var(--ease-site) 1000ms both;
  }

  @keyframes blur-up {
    from {
      opacity: 0;
      filter: blur(4px);
      transform: translateY(12px);
    }

    to {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  @media (max-width: 1279px) {
    .hero-grid {
      grid-template-columns: 1.02fr 0.98fr;
      gap: 28px;
      min-height: 600px;
    }

    .hero-title {
      font-size: clamp(42px, 5vw, 60px);
    }
  }

  @media (max-width: 1023px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 0;
      min-height: 0;
    }

    .hero-copy {
      max-width: 640px;
      margin-inline: auto;
      padding: 72px 0 80px;
      text-align: center;
    }

    .hero-title {
      font-size: clamp(44px, 6.2vw, 60px);
    }

    .hero-lead,
    .hero-facts {
      margin-inline: auto;
    }

    .hero-actions,
    .hero-facts {
      justify-content: center;
    }

    .hero-art {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .hero-copy {
      padding: 56px 0 64px;
    }

    .hero-title {
      font-size: var(--type-h1-size);
      line-height: var(--type-h1-line);
      letter-spacing: var(--type-h1-track);
    }

    .hero-lead {
      margin-top: 20px;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      margin-top: 28px;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .hero-facts {
      margin-top: 30px;
      padding-top: 14px;
      font-size: 9px;
      gap: 6px 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy > *,
    .hero-art {
      animation: none;
    }
  }
</style>
