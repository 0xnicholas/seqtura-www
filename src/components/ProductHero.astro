---
import type { ProductCopy } from '../data/products';

interface Props {
  product: ProductCopy;
}

const { product } = Astro.props;
---

<section class="product-hero" aria-labelledby="product-hero-title">
  <div class="container-site">
    <div class="hero-copy">
      <p class="kicker">{product.hero.kicker}</p>
      <h1 id="product-hero-title" class="type-h1 hero-title">
        {product.name}
      </h1>
      <p class="type-lead hero-lead">{product.hero.lead}</p>

      <ul class="hero-tags" aria-label="产品属性">
        {product.hero.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* 产品 hero 刻意不带红色光晕：§4 把光晕限定在全站 5 处，产品页靠结构与排版区分。 */
  .product-hero {
    position: relative;
    overflow: hidden;
    padding: 96px 0 88px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .hero-copy {
    max-width: 940px;
    animation: hero-in var(--duration-enter) var(--ease-site) both;
  }

  .hero-title {
    margin-top: 24px;
  }

  .hero-lead {
    max-width: 740px;
    margin-top: 26px;
    color: var(--color-muted);
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 30px;
  }

  .hero-tags li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 28px;
    padding: 0 12px;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--color-ink-2);
  }

  .hero-tags li::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--color-red);
  }

  @media (max-width: 767px) {
    .product-hero {
      padding: 64px 0 56px;
    }

    .hero-tags {
      margin-top: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy {
      animation: none;
    }
  }
</style>
