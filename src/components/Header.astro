---
import Brand from './Brand.astro';
import { isNavSection, navItems, site } from '../config/site';
import { placeholders } from '../config/placeholders';

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="site-header" data-header>
  <div class="container-site header-inner">
    <Brand />

    <nav class="desktop-nav" aria-label="主导航">
      {navItems.map((item, index) =>
        isNavSection(item) ? (
          <div class="nav-section" data-nav-section>
            <button
              type="button"
              class:list={[
                'nav-section-trigger',
                { 'is-active': item.items.some((link) => isActive(link.href)) },
              ]}
              aria-expanded="false"
              aria-controls={`nav-section-${index}`}
              data-nav-section-trigger
            >
              {item.label}
              <svg
                class="nav-caret"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <g>
                  <path d="M5.75 8.75L10 13" />
                  <path d="M10 13L14.25 8.75" />
                </g>
              </svg>
            </button>
            <ul class="nav-section-menu" id={`nav-section-${index}`} data-nav-section-menu hidden>
              {item.items.map((link) => (
                <li>
                  <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ),
      )}
    </nav>

    <div class="header-actions">
      <a class="header-email" href={`mailto:${placeholders.contactEmail.value}`}>
        {placeholders.contactEmail.value}
      </a>
      <a class="btn btn-primary btn-sm header-cta" href={site.contactPath} data-primary-cta>
        预约沟通
      </a>
      <a class="btn btn-primary btn-sm header-cta-compact" href={site.contactPath} data-primary-cta>
        预约
      </a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="打开菜单"
        data-menu-toggle
      >
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="移动端主导航">
      {navItems.map((item, index) =>
        isNavSection(item) ? (
          <div class="mobile-nav-section">
            <button
              type="button"
              class:list={[
                'mobile-nav-section-trigger',
                { 'is-active': item.items.some((link) => isActive(link.href)) },
              ]}
              aria-expanded="false"
              aria-controls={`mobile-nav-section-${index}`}
              data-mobile-section-trigger
            >
              {item.label}
              <svg
                class="nav-caret"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <g>
                  <path d="M5.75 8.75L10 13" />
                  <path d="M10 13L14.25 8.75" />
                </g>
              </svg>
            </button>
            <ul class="mobile-nav-section-menu" id={`mobile-nav-section-${index}`} hidden>
              {item.items.map((link) => (
                <li>
                  <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ),
      )}
    </nav>
  </div>
</header>

<script is:inline src="/scripts/site.js" defer></script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    background: rgb(255 255 255 / 88%);
    backdrop-filter: blur(8px);
    transition: border-color var(--duration-micro) var(--ease-site);
  }

  .site-header.is-scrolled {
    border-bottom-color: rgb(0 0 0 / 9%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 36px;
    height: var(--header-h);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    /* 填充块自带 12px 内边距，回退 8px 让首个标签停在原位（36 + 4 = 28 + 12）。 */
    margin-left: -8px;
  }

  /* 填充块几何照 laravel.com 导航：36px 高、12px 内边距、8px 圆角；
     gap 由 30px 降到 6px，12 + 6 + 12 = 30px，字到字节奏不变（#60）。 */
  .desktop-nav > a,
  .nav-section-trigger {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-site);
    background: transparent;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--color-ink-2);
    transition:
      background-color var(--duration-micro) var(--ease-site),
      color var(--duration-micro) var(--ease-site);
  }

  .nav-section-trigger {
    cursor: pointer;
  }

  .desktop-nav > a:hover,
  .nav-section-trigger:hover,
  .nav-section-trigger[aria-expanded='true'] {
    background: var(--color-red-tint);
    color: var(--color-ink);
  }

  /* 当前页常驻一档（14%）；写在 hover 之后，悬停当前项不会退回 5%。 */
  .desktop-nav > a[aria-current='page'],
  .nav-section-trigger.is-active {
    background: var(--color-red-faded);
    color: var(--color-ink);
  }

  .nav-section {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* laravel.com 同款箭头：20×20 视框、1.5 描边、圆头、红描边。 */
  .nav-caret {
    flex: none;
    width: 20px;
    height: 20px;
    margin-left: 6px;
    color: var(--color-red);
  }

  /* 展开时 ∨ 收成 ∧：<g> 上提 5.25px，两臂各绕 (10px,13px) 旋转 ∓90°（#60 判例）。 */
  .nav-caret g,
  .nav-caret path {
    transition: transform var(--duration-micro) var(--ease-site);
  }

  .nav-caret path {
    transform-box: view-box;
    transform-origin: 10px 13px;
  }

  .nav-section-trigger[aria-expanded='true'] .nav-caret g,
  .mobile-nav-section-trigger[aria-expanded='true'] .nav-caret g {
    transform: translateY(-5.25px);
  }

  .nav-section-trigger[aria-expanded='true'] .nav-caret path:first-child,
  .mobile-nav-section-trigger[aria-expanded='true'] .nav-caret path:first-child {
    transform: rotate(-90deg);
  }

  .nav-section-trigger[aria-expanded='true'] .nav-caret path:last-child,
  .mobile-nav-section-trigger[aria-expanded='true'] .nav-caret path:last-child {
    transform: rotate(90deg);
  }

  .nav-section-menu {
    position: absolute;
    /* 触发器高 36px、居中的话上边距 14px，取 14px 让面板顶边仍与 header 底边齐平。 */
    top: calc(100% + 14px);
    left: 50%;
    min-width: 168px;
    padding: 6px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-sm);
    background: var(--color-canvas);
    box-shadow: 0 12px 24px rgb(0 0 0 / 6%);
    transform: translateX(-50%);
    list-style: none;
  }

  /* 触发器与面板之间 14px 的间隙必须算在悬停区内，否则鼠标下移即关闭。 */
  .nav-section-menu::before {
    content: '';
    position: absolute;
    top: -14px;
    right: 0;
    left: 0;
    height: 14px;
  }

  .nav-section-menu a {
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 12px;
    border-radius: var(--radius-site-sm);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink-2);
    white-space: nowrap;
    transition:
      background-color var(--duration-micro) var(--ease-site),
      color var(--duration-micro) var(--ease-site);
  }

  .nav-section-menu a:hover,
  .nav-section-menu a:focus-visible {
    background: var(--color-red-tint);
    color: var(--color-ink);
  }

  /* 面板展开时当前页子项常驻 14% 底；原实现只有 aria-current 没有视觉（#60）。 */
  .nav-section-menu a[aria-current='page'] {
    background: var(--color-red-faded);
    color: var(--color-ink);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-left: auto;
  }

  .header-email {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    color: var(--color-muted);
    transition: color var(--duration-micro) var(--ease-site);
  }

  .header-email:hover {
    color: var(--color-red-dark);
  }

  .header-cta-compact {
    display: none;
  }

  .menu-toggle {
    display: none;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-sm);
    background: var(--color-canvas);
    cursor: pointer;
  }

  .menu-toggle span {
    position: relative;
    display: block;
    width: 16px;
    height: 1px;
    background: var(--color-ink);
  }

  .menu-toggle span::before,
  .menu-toggle span::after {
    content: '';
    position: absolute;
    left: 0;
    width: 16px;
    height: 1px;
    background: var(--color-ink);
    transition:
      transform var(--duration-micro) var(--ease-site),
      top var(--duration-micro) var(--ease-site);
  }

  .menu-toggle span::before {
    top: -5px;
  }

  .menu-toggle span::after {
    top: 5px;
  }

  .menu-toggle[aria-expanded='true'] span {
    background: transparent;
  }

  .menu-toggle[aria-expanded='true'] span::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    position: absolute;
    top: var(--header-h);
    right: 0;
    left: 0;
    /* 内边距回退 12px，让填充块内的文字仍与品牌字标对齐。 */
    padding: 8px calc(var(--gutter) - 12px) 20px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
    box-shadow: 0 12px 24px rgb(0 0 0 / 6%);
  }

  /* 填充块与贯穿到底的分隔线必然打架，抽屉改为 pill 行（#60）。 */
  .mobile-menu > nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-menu a {
    display: flex;
    align-items: center;
    height: 48px;
    padding: 0 12px;
    border-radius: var(--radius-site);
    font-size: 16px;
    font-weight: 500;
  }

  .mobile-menu a[aria-current='page'],
  .mobile-nav-section-trigger.is-active {
    background: var(--color-red-faded);
    color: var(--color-ink);
  }

  .mobile-nav-section-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 48px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-site);
    background: transparent;
    font-family: inherit;
    font-size: 16px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }

  .mobile-nav-section-menu {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 2px;
  }

  .mobile-nav-section-menu a {
    margin-left: 16px;
    font-size: 15px;
  }

  @media (max-width: 1023px) {
    .desktop-nav,
    .header-email,
    .header-cta {
      display: none;
    }

    .header-cta-compact,
    .menu-toggle {
      display: inline-flex;
    }

    .header-inner {
      gap: 16px;
    }

    .header-actions {
      gap: 12px;
    }

    /* laravel.com 在 <lg 用 16px 箭头。 */
    .nav-caret {
      width: 16px;
      height: 16px;
    }
  }

  @media (max-width: 767px) {
    .header-inner {
      gap: 12px;
    }

    .header-actions {
      gap: 8px;
    }

    .header-cta-compact {
      height: 34px;
      padding: 0 14px;
    }
  }
</style>
