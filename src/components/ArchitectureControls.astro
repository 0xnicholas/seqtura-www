---
import SectionHeading from './SectionHeading.astro';
import { architectureCopy, controlPlanes } from '../data/architecture';

const { controls } = architectureCopy;
---

<section class="section controls-section" id="controls" aria-labelledby="controls-title">
  <div class="container-site">
    <SectionHeading
      id="controls-title"
      kicker={controls.kicker}
      title={controls.title}
      lead={controls.lead}
    />

    <div class="table-frame reveal">
      <table class="controls-table">
        <caption class="table-caption">{controls.caption}</caption>
        <thead>
          <tr>
            <th scope="col">控制面</th>
            <th scope="col">管什么</th>
            <th scope="col">落在哪</th>
            <th scope="col">怎么验证</th>
          </tr>
        </thead>
        <tbody>
          {controlPlanes.map((plane) => (
            <tr data-control-plane={plane.id}>
              <th scope="row" class="plane-cell">
                <span class="plane-code">{plane.code}</span>
                <span class="plane-name">{plane.name}</span>
                <span class="plane-label">{plane.label}</span>
              </th>
              <td data-control-field="manages" data-label="管什么">
                {plane.manages}
              </td>
              <td data-control-field="lands" data-label="落在哪">
                {plane.lands}
              </td>
              <td data-control-field="verifies" data-label="怎么验证">
                {plane.verifies}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="controls-note">
      <span class="tick" aria-hidden="true"></span>
      {controls.note}
    </p>
  </div>
</section>

<style>
  .controls-section {
    background: var(--color-paper);
  }

  .table-frame {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-lg);
    background: var(--color-canvas);
  }

  .controls-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .table-caption {
    padding: 13px 18px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    text-align: left;
  }

  .controls-table th,
  .controls-table td {
    padding: 20px 18px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }

  .controls-table th:last-child,
  .controls-table td:last-child {
    border-right: 0;
  }

  .controls-table tbody tr:last-child th,
  .controls-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .controls-table thead th {
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .controls-table thead th:first-child {
    width: 24%;
  }

  .controls-table thead th:nth-child(2) {
    width: 27%;
  }

  .controls-table thead th:nth-child(3) {
    width: 24%;
  }

  .controls-table thead th:nth-child(4) {
    width: 25%;
  }

  .plane-cell {
    font-weight: 400;
  }

  .plane-code {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-red-dark);
  }

  .plane-name {
    display: block;
    margin-top: 8px;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.4;
  }

  .plane-label {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .controls-table td {
    font-size: 13px;
    line-height: 1.8;
    color: var(--color-ink-2);
  }

  .controls-table td[data-control-field='verifies'] {
    color: var(--color-muted);
  }

  .controls-note {
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr);
    gap: 10px;
    max-width: 880px;
    margin-top: 18px;
    font-size: 12px;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .controls-note .tick {
    margin-top: 8px;
  }

  @media (max-width: 1023px) {
    .controls-table,
    .controls-table tbody,
    .controls-table tr,
    .controls-table th,
    .controls-table td {
      display: block;
      width: 100%;
    }

    .controls-table caption,
    .controls-table thead {
      position: absolute;
      display: block;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .controls-table thead tr,
    .controls-table thead th {
      display: block;
      width: auto;
      height: auto;
      padding: 0;
      border: 0;
      white-space: normal;
    }

    .controls-table tbody tr {
      padding: 20px;
      border-bottom: 1px solid var(--color-line);
    }

    .controls-table tbody tr:last-child {
      border-bottom: 0;
    }

    .controls-table th,
    .controls-table td {
      padding: 0;
      border: 0;
    }

    .plane-cell {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px 10px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--color-line);
    }

    .plane-code {
      display: inline;
    }

    .plane-name {
      display: inline;
      margin-top: 0;
      font-size: 19px;
    }

    .plane-label {
      display: block;
      flex: 1 1 100%;
      margin-top: 0;
    }

    .controls-table td {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 10px;
      padding: 10px 0;
      border-bottom: 1px solid var(--color-line);
    }

    .controls-table td:last-child {
      border-bottom: 0;
    }

    .controls-table td::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: 9px;
      line-height: 1.8;
      letter-spacing: 0.04em;
      color: var(--color-muted);
    }
  }

  @media (max-width: 767px) {
    .controls-table tbody tr {
      padding: 18px 16px;
    }

    .controls-table td {
      grid-template-columns: 1fr;
      gap: 3px;
    }
  }
</style>
