---
import SectionHeading from './SectionHeading.astro';
import { methodologyCopy, methodologyPrinciples } from '../data/delivery';

const { principles } = methodologyCopy;
---

<section class="section principles-section" id="principles" aria-labelledby="principles-title">
  <div class="container-site">
    <SectionHeading
      id="principles-title"
      kicker={principles.kicker}
      title={principles.title}
      lead={principles.lead}
    />

    <div class="principle-grid reveal">
      {methodologyPrinciples.map((principle, index) => (
        <article class="principle-card" data-principle={index + 1}>
          <span class="principle-no">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="principle-title">{principle.title}</h3>
          <p class="principle-label">{principle.label}</p>
          <p class="principle-copy">{principle.summary}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .principles-section {
    background: var(--color-canvas);
  }

  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .principle-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 36px 34px 34px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    transition: background-color var(--duration-micro) var(--ease-site);
  }

  .principle-card:hover {
    background: var(--color-paper);
  }

  .principle-no {
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--color-red-dark);
  }

  .principle-title {
    margin-top: 18px;
    font-size: 26px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .principle-label {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .principle-copy {
    margin-top: 20px;
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  @media (max-width: 1023px) {
    .principle-grid {
      grid-template-columns: 1fr;
    }

    .principle-card {
      padding: 30px 28px 28px;
    }
  }

  @media (max-width: 767px) {
    .principle-card {
      padding: 26px 24px 24px;
    }

    .principle-title {
      font-size: 22px;
    }
  }
</style>
