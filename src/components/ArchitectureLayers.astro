---
import SectionHeading from './SectionHeading.astro';
import { architectureCopy, architectureLayers } from '../data/architecture';

const { layers } = architectureCopy;
---

<section class="section layers-section" id="layers" aria-labelledby="layers-title">
  <div class="container-site">
    <SectionHeading
      id="layers-title"
      kicker={layers.kicker}
      title={layers.title}
      lead={layers.lead}
    />

    <div class="table-frame reveal">
      <table class="layers-table">
        <caption class="table-caption">{layers.caption}</caption>
        <thead>
          <tr>
            <th scope="col">层</th>
            <th scope="col">负责什么</th>
            <th scope="col">关键约束</th>
            <th scope="col">我们的做法</th>
            <th scope="col">能力</th>
          </tr>
        </thead>
        <tbody>
          {architectureLayers.map((layer) => (
            <tr data-layer={layer.id}>
              <th scope="row" class="layer-cell">
                <span class="layer-no">{layer.no}</span>
                <span class="layer-name">{layer.name}</span>
                <span class="layer-label">{layer.label}</span>
              </th>
              <td data-layer-field="responsibility" data-label="负责什么">
                {layer.responsibility}
              </td>
              <td data-layer-field="constraint" data-label="关键约束">
                {layer.constraint}
              </td>
              <td data-layer-field="practice" data-label="我们的做法">
                {layer.practice}
              </td>
              <td data-layer-field="chips" data-label="能力">
                <ul class="layer-chips" aria-label={`${layer.name}能力`}>
                  {layer.chips.map((chip) => (
                    <li class="chip" data-layer-chip>
                      {chip}
                    </li>
                  ))}
                </ul>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .layers-section {
    background: var(--color-canvas);
  }

  .table-frame {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-lg);
  }

  .layers-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .table-caption {
    padding: 13px 18px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    text-align: left;
  }

  .layers-table th,
  .layers-table td {
    padding: 18px 16px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    vertical-align: top;
  }

  .layers-table th:last-child,
  .layers-table td:last-child {
    border-right: 0;
  }

  .layers-table tbody tr:last-child th,
  .layers-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .layers-table thead th {
    background: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-muted);
    text-transform: uppercase;
  }

  .layers-table thead th:first-child {
    width: 20%;
  }

  .layers-table thead th:nth-child(2) {
    width: 21%;
  }

  .layers-table thead th:nth-child(3) {
    width: 22%;
  }

  .layers-table thead th:nth-child(4) {
    width: 25%;
  }

  .layers-table thead th:nth-child(5) {
    width: 12%;
  }

  .layer-cell {
    font-weight: 400;
  }

  .layer-no {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.05em;
    color: var(--color-red-dark);
  }

  .layer-name {
    display: block;
    margin-top: 6px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
  }

  .layer-label {
    display: block;
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 9px;
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .layers-table td {
    font-size: 13px;
    line-height: 1.75;
    color: var(--color-ink-2);
  }

  .layers-table td[data-layer-field='constraint'] {
    color: var(--color-muted);
  }

  .layer-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  @media (max-width: 1023px) {
    .layers-table,
    .layers-table tbody,
    .layers-table tr,
    .layers-table th,
    .layers-table td {
      display: block;
      width: 100%;
    }

    .layers-table caption,
    .layers-table thead {
      position: absolute;
      display: block;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .layers-table thead tr,
    .layers-table thead th {
      display: block;
      width: auto;
      height: auto;
      padding: 0;
      border: 0;
      white-space: normal;
    }

    .layers-table tbody tr {
      padding: 20px;
      border-bottom: 1px solid var(--color-line);
    }

    .layers-table tbody tr:last-child {
      border-bottom: 0;
    }

    .layers-table th,
    .layers-table td {
      padding: 0;
      border: 0;
    }

    .layer-cell {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px 10px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--color-line);
    }

    .layer-no {
      display: inline;
    }

    .layer-name {
      display: inline;
      margin-top: 0;
      font-size: 19px;
    }

    .layer-label {
      display: block;
      flex: 1 1 100%;
      margin-top: 0;
    }

    .layers-table td {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr);
      gap: 10px;
      padding: 10px 0;
      border-bottom: 1px solid var(--color-line);
    }

    .layers-table td:last-child {
      border-bottom: 0;
    }

    .layers-table td::before {
      content: attr(data-label);
      font-family: var(--font-mono);
      font-size: 9px;
      line-height: 1.8;
      letter-spacing: 0.04em;
      color: var(--color-muted);
    }

    .layer-chips {
      grid-column: 2;
      margin-top: -2px;
    }
  }

  @media (max-width: 767px) {
    .layers-table tbody tr {
      padding: 18px 16px;
    }

    .layers-table td {
      grid-template-columns: 1fr;
      gap: 3px;
    }

    .layer-chips {
      grid-column: 1;
      margin-top: 2px;
    }
  }
</style>
