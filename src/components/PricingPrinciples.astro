---
import SectionHeading from './SectionHeading.astro';
import { pricingCopy, pricingPrinciples } from '../data/process';
---

<section class="section pricing-section" id="pricing" aria-labelledby="pricing-title">
  <div class="container-site">
    <SectionHeading
      id="pricing-title"
      kicker={pricingCopy.kicker}
      title={pricingCopy.title}
      lead={pricingCopy.lead}
    />

    <div class="principle-grid">
      {pricingPrinciples.map((principle) => (
        <article class="principle-card" data-pricing-principle={principle.id}>
          <span class="principle-no">{principle.no}</span>
          <h3 class="principle-title">{principle.title}</h3>
          <p class="principle-label">{principle.label}</p>
          <p class="principle-summary">{principle.summary}</p>
        </article>
      ))}
    </div>

    <section class="support-panel" id="support" aria-labelledby="support-title">
      <div class="support-head">
        <p class="mono-label support-kicker">{pricingCopy.supportKicker}</p>
        <h3 id="support-title" class="support-title">
          {pricingCopy.supportTitle}
        </h3>
        <p class="support-lead">{pricingCopy.supportLead}</p>
      </div>

      <ul class="support-list">
        {pricingCopy.supportBoundaries.map((boundary) => (
          <li data-support-boundary>
            <span class="support-tick" aria-hidden="true"></span>
            {boundary}
          </li>
        ))}
      </ul>
    </section>
  </div>
</section>

<style>
  .pricing-section {
    background: var(--color-paper);
    scroll-margin-top: var(--header-h);
  }

  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }

  .principle-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 32px 30px 34px;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
    transition: background-color 150ms var(--ease-site);
  }

  .principle-card:hover {
    background: var(--color-red-wash);
  }

  .principle-no {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.06em;
    color: var(--color-red-dark);
  }

  .principle-no::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--color-red);
  }

  .principle-title {
    margin-top: 16px;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .principle-label {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.6;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .principle-summary {
    margin-top: 16px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-muted);
  }

  .support-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 40px 64px;
    margin-top: 56px;
    padding: 36px 38px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-site-lg);
    background: var(--color-canvas);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .support-kicker {
    color: var(--color-muted);
  }

  .support-title {
    max-width: 460px;
    margin-top: 14px;
    font-size: 27px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .support-lead {
    max-width: 480px;
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.8;
    color: var(--color-muted);
  }

  .support-list {
    align-self: start;
    border-top: 1px solid var(--color-line);
  }

  .support-list li {
    display: grid;
    grid-template-columns: 7px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    padding: 15px 0;
    border-bottom: 1px solid var(--color-line);
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-ink-2);
  }

  .support-tick {
    width: 7px;
    height: 7px;
    margin-top: 8px;
    background: var(--color-red);
  }

  @media (max-width: 1023px) {
    .principle-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .support-panel {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 30px 28px;
    }
  }

  @media (max-width: 767px) {
    .principle-grid {
      grid-template-columns: 1fr;
    }

    .principle-card {
      padding: 26px 24px 28px;
    }

    .principle-title {
      font-size: 22px;
    }

    .support-panel {
      margin-top: 40px;
      padding: 26px 24px;
    }

    .support-title {
      font-size: 23px;
    }
  }
</style>
