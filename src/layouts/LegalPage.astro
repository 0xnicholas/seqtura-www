---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { showPlaceholderMarks } from '../config/placeholders';
import { missingLegalPlaceholders } from '../config/legal';

interface Props {
  title: string;
  heading?: string;
  description: string;
  effectiveAt: Date;
  updatedAt: Date;
  version: string;
  headings?: readonly MarkdownHeading[];
}

const {
  title,
  heading = title,
  description,
  effectiveAt,
  updatedAt,
  version,
  headings = [],
} = Astro.props;

const dateFormat = new Intl.DateTimeFormat('zh-CN', { dateStyle: 'long', timeZone: 'UTC' });
const formatDate = (date: Date) => dateFormat.format(date);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
const tocHeadings = headings.filter((item) => item.depth === 2);
const sectionLabel = (text: string) => text.replace(/^\d+\.\s*/, '');
---

<BaseLayout title={title} description={description}>
  <article class="legal">
    <div class="container-site">
      <div class="legal-inner">
        <header class="legal-head">
          <p class="kicker">法务</p>
          <h1 class="legal-title">{heading}</h1>
          <dl class="legal-meta" data-legal-meta>
            <div>
              <dt>生效日期</dt>
              <dd>
                <time datetime={isoDate(effectiveAt)}>{formatDate(effectiveAt)}</time>
              </dd>
            </div>
            <div>
              <dt>最后更新</dt>
              <dd>
                <time datetime={isoDate(updatedAt)}>{formatDate(updatedAt)}</time>
              </dd>
            </div>
            <div>
              <dt>版本</dt>
              <dd>{version}</dd>
            </div>
          </dl>
          {showPlaceholderMarks && missingLegalPlaceholders.length > 0 && (
            <p class="preview-note" data-placeholder-note>
              预览：以下法务字段尚未配置——{missingLegalPlaceholders.join('、')}
              。生产构建会使用中性措辞或省略。
            </p>
          )}
        </header>

        {tocHeadings.length > 0 && (
          <nav class="legal-toc" aria-label="隐私政策目录" data-legal-toc>
            <p class="legal-toc-title">目录</p>
            <ol>
              {tocHeadings.map((item, index) => (
                <li>
                  <a href={`#${item.slug}`}>
                    <span class="legal-toc-index">{String(index + 1).padStart(2, '0')}</span>
                    <span>{sectionLabel(item.text)}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        <div class="legal-prose" data-legal-prose>
          <slot />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    --type-legal-h1-size: 40px;
    --type-legal-h1-line: 1.2;
    --type-legal-h2-size: 24px;
    --type-legal-h2-line: 1.4;
    --type-legal-h3-size: 18px;
    --type-legal-h3-line: 1.5;

    padding: 80px 0 96px;
  }

  .legal-inner {
    max-width: 720px;
    margin-inline: auto;
  }

  .legal-title {
    margin-top: 20px;
    font-family: var(--font-heading);
    font-size: var(--type-legal-h1-size);
    font-weight: 400;
    line-height: var(--type-legal-h1-line);
    letter-spacing: -0.02em;
  }

  .legal-title:lang(zh) {
    font-weight: 500;
  }

  .legal-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 28px;
    padding: 14px 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .legal-meta div {
    display: flex;
    gap: 8px;
  }

  .legal-meta dt {
    color: var(--color-muted);
  }

  .preview-note {
    display: inline-block;
    margin-top: 20px;
    padding: 6px 10px;
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-site-sm);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .legal-toc {
    margin-top: 32px;
    padding: 22px 0 8px;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .legal-toc-title {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.6;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .legal-toc ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 40px;
    margin-top: 12px;
    padding: 0;
    list-style: none;
  }

  .legal-toc a {
    display: flex;
    gap: 12px;
    padding: 8px 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-ink-2);
    transition: color 150ms var(--ease-site);
  }

  .legal-toc a:hover {
    color: var(--color-red-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-toc-index {
    flex: none;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.9;
    color: var(--color-muted);
  }

  .legal-prose {
    padding-top: 40px;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-ink-2);
  }

  .legal-prose :global(h2) {
    margin-top: 40px;
    font-size: var(--type-legal-h2-size);
    font-weight: 500;
    line-height: var(--type-legal-h2-line);
  }

  .legal-prose :global(h3) {
    margin-top: 28px;
    font-size: var(--type-legal-h3-size);
    font-weight: 500;
    line-height: var(--type-legal-h3-line);
  }

  .legal-prose :global(p),
  .legal-prose :global(ul),
  .legal-prose :global(ol) {
    margin-top: 16px;
    overflow-wrap: anywhere;
  }

  .legal-prose :global(ul) {
    list-style: disc;
    padding-left: 1.4em;
  }

  .legal-prose :global(ol) {
    list-style: decimal;
    padding-left: 1.5em;
  }

  .legal-prose :global(li) {
    margin-top: 6px;
  }

  .legal-prose :global(a) {
    color: var(--color-red-dark);
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .legal-prose :global(a:hover) {
    text-decoration-thickness: 2px;
  }

  @media (max-width: 767px) {
    .legal {
      padding: 56px 0 72px;
    }

    .legal-toc ol {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
