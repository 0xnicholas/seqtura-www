---
import BaseLayout from './BaseLayout.astro';
import type { PageAnchor } from '../config/site';
import { showPlaceholderMarks } from '../config/placeholders';

interface Props {
  title: string;
  description: string;
  heading: string;
  anchors: readonly PageAnchor[];
}

const { title, description, heading, anchors } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container-site">
      <p class="kicker">Seqtura AI</p>
      <h1 class="type-h1 page-title">{heading}</h1>
      <p class="type-lead page-lead">{description}</p>
      {showPlaceholderMarks && <p class="preview-note">预览占位：本页内容将在后续实现票中补全。</p>}
    </div>
  </section>

  <section class="section page-body">
    <div class="container-site page-grid">
      <aside class="page-toc" aria-label="本页结构">
        <p class="mono-label toc-title">本页结构</p>
        <ul>
          {anchors.map((anchor) => (
            <li>
              <a href={`#${anchor.id}`}>{anchor.label}</a>
            </li>
          ))}
        </ul>
      </aside>

      <div class="page-prose">
        <slot />
        {anchors.map((anchor) => (
          <section id={anchor.id} class="anchor-stub" aria-labelledby={`${anchor.id}-title`}>
            <h2 id={`${anchor.id}-title`} class="type-h3">
              {anchor.label}
            </h2>
            {showPlaceholderMarks && (
              <p class="preview-note">本节的完整内容将在后续实现票中补全。</p>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    position: relative;
    padding: 88px 0 64px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .page-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: max(var(--gutter), calc((100vw - var(--container-site)) / 2));
    width: 7px;
    height: 7px;
    background: var(--color-red);
  }

  .page-title {
    max-width: 840px;
    margin-top: 22px;
  }

  .page-lead {
    max-width: 680px;
    margin-top: 24px;
    color: var(--color-muted);
  }

  .preview-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding: 6px 10px;
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-site-sm);
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
    letter-spacing: 0.03em;
    color: var(--color-muted);
  }

  .page-grid {
    display: grid;
    grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .page-toc {
    position: sticky;
    top: calc(var(--header-h) + 24px);
  }

  .toc-title {
    color: var(--color-faint);
  }

  .page-toc ul {
    display: grid;
    gap: 2px;
    margin-top: 16px;
    border-top: 1px solid var(--color-line);
  }

  .page-toc li {
    border-bottom: 1px solid var(--color-line);
  }

  .page-toc a {
    display: block;
    padding: 10px 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-muted);
    transition: color 150ms var(--ease-site);
  }

  .page-toc a:hover {
    color: var(--color-red-dark);
  }

  .page-prose {
    max-width: 760px;
  }

  .page-prose :global(p) {
    color: var(--color-ink-2);
  }

  .anchor-stub {
    padding: 28px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .anchor-stub:first-of-type {
    border-top: 1px solid var(--color-line);
  }

  .anchor-stub h2 {
    margin-bottom: 8px;
  }

  .anchor-stub .preview-note {
    margin-top: 0;
  }

  @media (max-width: 1023px) {
    .page-hero {
      padding: 64px 0 56px;
    }

    .page-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .page-toc {
      position: static;
    }

    .page-toc ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .page-hero {
      padding: 56px 0 48px;
    }

    .page-toc ul {
      grid-template-columns: 1fr;
    }
  }
</style>
