---
import { publishedPage } from '../../content/entry';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductHero from '../../components/ProductHero.astro';
import ProductBody from '../../components/ProductBody.astro';
import { products } from '../../data/products';

const { data } = await publishedPage('heirloom');
const { title, description } = data;
---

<BaseLayout title={title} description={description}>
  <ProductHero product={products.heirloom} />
  <ProductBody product={products.heirloom} />
</BaseLayout>
