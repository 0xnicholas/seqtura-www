---
import { publishedPage } from '../content/entry';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import MethodologyPreview from '../components/MethodologyPreview.astro';
import ArchitectureBento from '../components/ArchitectureBento.astro';
import DeliverySection from '../components/DeliverySection.astro';
import FitSituations from '../components/FitSituations.astro';
import CtaSection from '../components/CtaSection.astro';

const { data } = await publishedPage('home');
const { title, description } = data;
---

<BaseLayout title={title} description={description}>
  <HomeHero />
  <ProofStrip />
  <MethodologyPreview />
  <ArchitectureBento />
  <DeliverySection />
  <FitSituations />
  <CtaSection />
</BaseLayout>
