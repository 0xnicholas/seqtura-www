---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout
  title={`页面不存在 | ${site.name}`}
  description="你访问的页面可能已移动或不存在。"
  noindex
>
  <section class="not-found">
    <div class="container-site">
      <p class="kicker">404</p>
      <h1 class="type-h1 not-found-title">页面不存在</h1>
      <p class="type-lead not-found-lead">你访问的页面可能已移动或不存在。</p>
      <div class="cta-row not-found-actions">
        <a class="btn btn-primary" href={site.contactPath}>
          预约沟通
        </a>
        <a class="btn btn-ghost" href="/">
          返回首页
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    align-items: center;
    min-height: calc(100vh - var(--header-h) - 420px);
    padding: 96px 0 112px;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-canvas);
  }

  .not-found-title {
    margin-top: 22px;
  }

  .not-found-lead {
    max-width: 560px;
    margin-top: 22px;
    color: var(--color-muted);
  }

  .not-found-actions {
    margin-top: 34px;
  }

  @media (max-width: 767px) {
    .not-found {
      padding: 72px 0 80px;
    }

    .not-found-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .not-found-actions .btn {
      width: 100%;
    }
  }
</style>
