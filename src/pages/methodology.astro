---
import { publishedPage } from '../content/entry';
import BaseLayout from '../layouts/BaseLayout.astro';
import MethodologyHero from '../components/MethodologyHero.astro';
import MethodologyPrinciples from '../components/MethodologyPrinciples.astro';
import MethodologyStages from '../components/MethodologyStages.astro';
import MethodologyArtifacts from '../components/MethodologyArtifacts.astro';
import MethodologyDivision from '../components/MethodologyDivision.astro';
import MethodologyCta from '../components/MethodologyCta.astro';

const { data } = await publishedPage('methodology');
const { title, description } = data;
---

<BaseLayout title={title} description={description}>
  <MethodologyHero />
  <MethodologyPrinciples />
  <MethodologyStages />
  <MethodologyArtifacts />
  <MethodologyDivision />
  <MethodologyCta />
</BaseLayout>
