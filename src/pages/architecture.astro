---
import { publishedPage } from '../content/entry';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchitectureHero from '../components/ArchitectureHero.astro';
import ArchitectureOverview from '../components/ArchitectureOverview.astro';
import ArchitectureLifecycle from '../components/ArchitectureLifecycle.astro';
import ArchitectureLayers from '../components/ArchitectureLayers.astro';
import ArchitectureControls from '../components/ArchitectureControls.astro';
import EnterpriseConcerns from '../components/EnterpriseConcerns.astro';
import ArchitectureScenarios from '../components/ArchitectureScenarios.astro';
import ArchitectureMetrics from '../components/ArchitectureMetrics.astro';
import ArchitectureCta from '../components/ArchitectureCta.astro';

const { data } = await publishedPage('architecture');
const { title, description } = data;
---

<BaseLayout title={title} description={description}>
  <ArchitectureHero />
  <ArchitectureOverview />
  <ArchitectureLifecycle />
  <ArchitectureLayers />
  <ArchitectureControls />
  <EnterpriseConcerns />
  <ArchitectureScenarios />
  <ArchitectureMetrics />
  <ArchitectureCta />
</BaseLayout>
