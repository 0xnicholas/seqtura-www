# Build-time configuration. Public values are inlined into the static output;
# never put secrets in PUBLIC_* variables.

# Canonical origin used for sitemap, canonical links and social images.
SITE_URL=https://seqtura.ai

# Contact channels. Replace before launch.
PUBLIC_CONTACT_EMAIL=hello@seqtura.ai
PUBLIC_PRIVACY_EMAIL=privacy@seqtura.ai
# Public desktop entry shown under the Feishu QR: opening it in a browser adds
# the contact without scanning. Defaults to the link embedded in
# public/feishu-qr.png; set it when you re-shoot the card.
PUBLIC_FEISHU_URL=
# Contact QR images. Both default to the codes cropped out of the cards in
# src/assets/ (public/wecom-qr.png, public/feishu-qr.png); set these to swap in a
# different image. Must be same-origin: the CSP allows img-src 'self' data: only.
PUBLIC_WECOM_QR=
PUBLIC_FEISHU_QR=

# Legal entity and hosting placeholders. Leave empty to use neutral wording
# or omit the clause from the legal pages.
PUBLIC_OPERATOR_NAME=
PUBLIC_REGISTERED_ADDRESS=
PUBLIC_SITE_DOMAIN=
PUBLIC_OPERATOR_LOCATION=
# Mailbox provider displayed in the privacy policy.
PUBLIC_EMAIL_PROVIDER=
PUBLIC_HOSTING_PROVIDER=
PUBLIC_HOSTING_LOCATION=
# ISO date (YYYY-MM-DD); overrides the effective date in the legal pages.
PUBLIC_LAUNCH_DATE=
# Optional ISO date for the legal "last updated" value; defaults to PUBLIC_LAUNCH_DATE.
PUBLIC_LEGAL_UPDATED_AT=
# Displayed on the privacy policy.
PUBLIC_PRIVACY_VERSION=1.0

# Filing numbers. When absent, the footer hides the whole entry.
PUBLIC_ICP_NUMBER=
PUBLIC_PSB_NUMBER=

# Show preview-only placeholder badges. Keep false for production builds.
PUBLIC_SHOW_PLACEHOLDERS=false
