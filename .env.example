# Build-time configuration. Public values are inlined into the static output;
# never put secrets in PUBLIC_* variables.

# Canonical origin used for sitemap, canonical links and social images.
SITE_URL=https://seqtura.ai

# Contact channels. Replace before launch.
PUBLIC_CONTACT_EMAIL=hello@seqtura.ai
PUBLIC_PRIVACY_EMAIL=privacy@seqtura.ai
PUBLIC_FEISHU_URL=
PUBLIC_WECHAT_QR=
# Optional absolute URL when the form endpoint is deployed separately. Defaults to /api/contact.
# A cross-origin endpoint also needs its origin in the CSP connect-src directive in public/_headers.
PUBLIC_CONTACT_ENDPOINT=

# Contact endpoint runtime. These are read by the Node server, not inlined into static HTML.
# live delivers through Feishu/email, test validates without delivery, off returns 503
# with the email fallback. An unset or unrecognized value fails safe to off.
# Preview deployments must set FORM_MODE=test explicitly; production sets live only
# after credentials are ready.
FORM_MODE=test
# Per-IP limit. live defaults to 5 requests per hour; test has no limiter unless set.
CONTACT_RATE_LIMIT_MAX=
CONTACT_RATE_LIMIT_WINDOW_MS=3600000
# The bundled limiter is an in-memory adapter for dev and tests: counters are per
# server process. Production must enforce the same limit in the host WAF or a
# shared KV store; do not add a database to this site for rate limiting.

# Delivery providers. Never expose these through PUBLIC_* variables.
# Feishu custom bot: sends an interactive card. The secret enables request signing.
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Email delivery. EMAIL_PROVIDER=smtp uses nodemailer with the SMTP_* values below.
# aliyun / tencent are reserved for a domestic HTTP API integration; until that is
# implemented they return provider_not_available. Resend is not used.
EMAIL_PROVIDER=
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=465
# true for implicit TLS (typically 465), false for STARTTLS or a local sink (587/25).
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=
# Must be an address on a verified sending domain.
CONTACT_FROM_EMAIL=

# Legal entity and hosting placeholders. Leave empty to use neutral wording
# or omit the clause from the legal pages.
PUBLIC_OPERATOR_NAME=
PUBLIC_REGISTERED_ADDRESS=
PUBLIC_SITE_DOMAIN=
PUBLIC_OPERATOR_LOCATION=
PUBLIC_EMAIL_PROVIDER=
PUBLIC_HOSTING_PROVIDER=
PUBLIC_HOSTING_LOCATION=
# ISO date (YYYY-MM-DD); overrides the effective date in the legal pages.
PUBLIC_LAUNCH_DATE=
# Optional ISO date for the legal "last updated" value; defaults to PUBLIC_LAUNCH_DATE.
PUBLIC_LEGAL_UPDATED_AT=
# Displayed on the privacy policy and sent by the contact form as privacyVersion.
PUBLIC_PRIVACY_VERSION=1.0

# Filing numbers. When absent, the footer hides the whole entry.
PUBLIC_ICP_NUMBER=
PUBLIC_PSB_NUMBER=

# Show preview-only placeholder badges. Keep false for production builds.
PUBLIC_SHOW_PLACEHOLDERS=false
